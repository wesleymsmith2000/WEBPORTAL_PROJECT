---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Games">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Companion games</p>
      <h1 class="section-title">Strategy, velocity, and lore in playable form.</h1>
      <p class="lede">
        The portal will eventually host rules, tutorials, downloads, and match records
        for games connected to the AVVF universe.
      </p>
    </div>
  </section>

  <section class="section compact">
    <div class="container grid">
      <article class="card">
        <h2>Cipher Breyden</h2>
        <p>Mathematical strategy game rules, tutorials, and future digital implementation.</p>
      </article>
      <article class="card">
        <h2>Collatz-Concourse</h2>
        <p>Science-fiction racing rules, lore, replays, and tournament support.</p>
      </article>
    </div>
  </section>
</BaseLayout>
