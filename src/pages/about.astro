---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="About">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Project</p>
      <h1 class="section-title">A living archive for A Veil of Void and Fire.</h1>
      <p class="lede">
        This prototype establishes the maintainable foundation: Astro, TypeScript,
        markdown-driven episodes, static generation, responsive navigation, and dark
        cinematic presentation.
      </p>
    </div>
  </section>
</BaseLayout>
