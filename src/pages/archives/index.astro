---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title="Archives">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Concord Archives</p>
      <h1 class="section-title">Records recovered from the edge of sanctioned memory.</h1>
      <p class="lede">
        This area will hold in-universe papers, timeline entries, character dossiers,
        ship records, glossary terms, and technical notes.
      </p>
    </div>
  </section>

  <section class="section compact">
    <div class="container grid">
      <article class="card">
        <h2>Timeline</h2>
        <p>Major events, eras, conflicts, and disputed historical records.</p>
      </article>
      <article class="card">
        <h2>Technical Papers</h2>
        <p>Resonance theory, ship systems, mathematical notes, and academy lectures.</p>
      </article>
      <article class="card">
        <h2>Character Profiles</h2>
        <p>Dossiers, journals, affiliations, and hidden annotations.</p>
      </article>
      <article class="card">
        <h2>Ship Database</h2>
        <p>Frames, classes, schematics, and operational histories.</p>
      </article>
    </div>
  </section>
</BaseLayout>
