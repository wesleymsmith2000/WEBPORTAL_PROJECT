---
interface Props {
  title?: string;
  src?: string;
  note?: string;
}

const { title = "Soundtrack pending", src, note } = Astro.props;
---

<aside class="audio-dock" aria-label="Episode audio controls">
  <div>
    <p>Soundtrack</p>
    <strong>{title}</strong>
    {note && <small>{note}</small>}
  </div>
  {
    src ? (
      <audio controls preload="metadata" src={src}></audio>
    ) : (
      <button type="button" disabled>Audio Pending</button>
    )
  }
</aside>

<style>
  .audio-dock {
    position: sticky;
    bottom: 1rem;
    z-index: 8;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(920px, calc(100% - 32px));
    margin: 2rem auto 0;
    border: 1px solid rgba(210, 170, 99, 0.42);
    border-radius: 8px;
    padding: 0.85rem;
    background: rgba(13, 16, 22, 0.92);
    box-shadow: var(--shadow);
    backdrop-filter: blur(18px);
  }

  p,
  strong,
  small {
    display: block;
    margin: 0;
  }

  p {
    color: var(--cyan);
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  strong {
    line-height: 1.2;
  }

  small {
    max-width: 560px;
    color: var(--muted);
  }

  audio {
    width: min(360px, 44vw);
  }

  button {
    min-height: 40px;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 0.55rem 0.8rem;
    background: rgba(245, 239, 227, 0.06);
    color: var(--faint);
  }

  @media (max-width: 720px) {
    .audio-dock {
      align-items: stretch;
      flex-direction: column;
    }

    audio,
    button {
      width: 100%;
    }
  }
</style>
